{
  "name": "@booster/saas-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "db:generate": "prisma generate --schema ./prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema ./prisma/schema.prisma",
    "db:push": "prisma db push --schema ./prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "dev": "next dev",
    "format": "echo \"Formatting is handled at the workspace level.\"",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@prisma/client": "^6.15.0",
    "bcryptjs": "^3.0.2",
    "ioredis": "^5.7.0",
    "next": "^16.1.6",
    "next-auth": "5.0.0-beta.26",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "prisma": "^6.15.0",
    "tsx": "^4.20.0",
    "vitest": "^3.1.2"
  }
}
